{
  "rules": {
    "pairs": {
      "$code": {
        "logins": {
          ".read": true,
          "$role": {
            ".write": "auth != null && newData.exists() && newData.parent().parent().child('members').child($role).val() === auth.uid",
            ".validate": "newData.hasChildren(['gen', 'name']) && auth.token.email === $code + '.' + $role + '.' + newData.child('gen').val() + '@pair.belong.app'",
            "gen": {
              ".validate": "newData.isString() && newData.val().matches(/^[1-9][0-9]{0,3}$/)"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "members": {
          "$role": {
            ".write": "auth != null && newData.val() === auth.uid && $code.matches(/^[a-z0-9]{8}$/) && ($role === 'a' || $role === 'b') && auth.token.email === $code + '.' + $role + '.' + newData.parent().parent().child('logins').child($role).child('gen').val() + '@pair.belong.app' && (($role === 'a' && !data.parent().parent().exists()) || ($role === 'b' && !data.exists() && data.parent().child('a').exists()) || (data.exists() && data.parent().parent().child('reset').child($role).child('at').val() > now - 1800000 && !data.parent().parent().child('reset').child($role).child('used').exists() && newData.parent().parent().child('reset').child($role).child('used').val() === data.parent().parent().child('reset').child($role).child('code').val()))"
          }
        },
        "reset": {
          "$role": {
            ".write": "auth != null && newData.exists() && !newData.hasChild('used') && newData.child('code').isString() && newData.child('code').val().matches(/^[a-z0-9]{8}$/) && newData.child('at').val() === now && root.child('pairs').child($code).child('members').child($role).exists() && root.child('pairs').child($code).child('members').child($role).val() !== auth.uid && (root.child('pairs').child($code).child('members/a').val() === auth.uid || root.child('pairs').child($code).child('members/b').val() === auth.uid)",
            "used": {
              ".write": "auth != null && newData.parent().parent().parent().child('members').child($role).val() === auth.uid"
            }
          }
        },
        "chat": {
          ".read": "auth != null && (root.child('pairs').child($code).child('members/a').val() === auth.uid || root.child('pairs').child($code).child('members/b').val() === auth.uid)",
          "$msg": {
            ".write": "auth != null && newData.exists() && (root.child('pairs').child($code).child('members/a').val() === auth.uid || root.child('pairs').child($code).child('members/b').val() === auth.uid)",
            ".validate": "newData.hasChildren(['from', 'text', 'at']) && (data.exists() ? newData.child('from').val() === data.child('from').val() && newData.child('text').val() === data.child('text').val() && newData.child('at').val() === data.child('at').val() : newData.child('at').val() === now && root.child('pairs').child($code).child('members').child(newData.child('from').val()).val() === auth.uid)",
            "from": {
              ".validate": "newData.val() === 'a' || newData.val() === 'b'"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "heart": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "live": {
          ".read": "auth != null && (root.child('pairs').child($code).child('members/a').val() === auth.uid || root.child('pairs').child($code).child('members/b').val() === auth.uid)",
          "checkin": {
            "$role": {
              ".write": "auth != null && root.child('pairs').child($code).child('members').child($role).val() === auth.uid",
              ".validate": "newData.hasChildren(['mood', 'energy', 'at']) && newData.child('at').val() === now",
              "mood": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() % 1 === 0"
              },
              "energy": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() % 1 === 0"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "signal": {
            "$role": {
              ".write": "auth != null && root.child('pairs').child($code).child('members').child($role).val() === auth.uid",
              ".validate": "newData.hasChildren(['kind', 'at', 'id']) && newData.child('at').val() === now",
              "kind": {
                ".validate": "newData.val() === 'think' || newData.val() === 'safe' || newData.val() === 'support'"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "id": {
                ".validate": "newData.isString() && newData.val().length <= 24"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "count": {
            "$role": {
              "$month": {
                "$kind": {
                  ".write": "auth != null && root.child('pairs').child($code).child('members').child($role).val() === auth.uid && $month.matches(/^[0-9]{4}-[0-9]{2}$/) && ($kind === 'think' || $kind === 'safe' || $kind === 'support' || $kind === 'doodle')",
                  ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
                }
              }
            }
          },
          "tasks": {
            "$task": {
              ".write": "auth != null && (root.child('pairs').child($code).child('members/a').val() === auth.uid || root.child('pairs').child($code).child('members/b').val() === auth.uid)",
              ".validate": "newData.hasChildren(['title', 'owner', 'done', 'day'])",
              "title": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
              },
              "owner": {
                ".validate": "newData.val() === 'a' || newData.val() === 'b' || newData.val() === 'both'"
              },
              "done": {
                ".validate": "newData.isBoolean()"
              },
              "day": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "wishes": {
            "$role": {
              "$wish": {
                ".write": "auth != null && root.child('pairs').child($code).child('members').child($role).val() === auth.uid",
                ".validate": "newData.hasChildren(['title', 'at'])",
                "title": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
                },
                "price": {
                  ".validate": "newData.isString() && newData.val().length <= 24"
                },
                "link": {
                  ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().beginsWith('https://') || newData.val().beginsWith('http://'))"
                },
                "note": {
                  ".validate": "newData.isString() && newData.val().length <= 200"
                },
                "at": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          },
          "doodle": {
            "$role": {
              ".write": "auth != null && root.child('pairs').child($code).child('members').child($role).val() === auth.uid",
              ".validate": "newData.hasChildren(['png', 'at', 'id']) && newData.child('at').val() === now",
              "png": {
                ".validate": "newData.isString() && newData.val().length < 700000 && newData.val().beginsWith('iVBOR')"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "id": {
                ".validate": "newData.isString() && newData.val().length <= 24"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "dreams": {
            "$dream": {
              ".write": "auth != null && (root.child('pairs').child($code).child('members/a').val() === auth.uid || root.child('pairs').child($code).child('members/b').val() === auth.uid)",
              ".validate": "newData.hasChildren(['title', 'emoji', 'cat', 'owner', 'at'])",
              "title": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
              },
              "emoji": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
              },
              "cat": {
                ".validate": "newData.val() === 'travel' || newData.val() === 'home' || newData.val() === 'money' || newData.val() === 'health' || newData.val() === 'fun' || newData.val() === 'family'"
              },
              "owner": {
                ".validate": "newData.val() === 'a' || newData.val() === 'b' || newData.val() === 'both'"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "goal": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
              },
              "done": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "goals": {
            "$goal": {
              ".write": "auth != null && (root.child('pairs').child($code).child('members/a').val() === auth.uid || root.child('pairs').child($code).child('members/b').val() === auth.uid)",
              ".validate": "newData.hasChildren(['title', 'emoji', 'at'])",
              "title": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
              },
              "emoji": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "target": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
              },
              "unit": {
                ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 4"
              },
              "dream": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
              },
              "done": {
                ".validate": "newData.isBoolean()"
              },
              "saved": {
                "$role": {
                  ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= 1000000000000 && ($role === 'a' || $role === 'b') && (newData.val() === data.val() || root.child('pairs').child($code).child('members').child($role).val() === auth.uid)"
                }
              },
              "steps": {
                "$step": {
                  ".validate": "newData.hasChildren(['title', 'who', 'done', 'at'])",
                  "title": {
                    ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
                  },
                  "who": {
                    ".validate": "newData.val() === 'a' || newData.val() === 'b' || newData.val() === 'both'"
                  },
                  "done": {
                    ".validate": "newData.isBoolean()"
                  },
                  "due": {
                    ".validate": "newData.isNumber() && newData.val() % 1 === 0"
                  },
                  "at": {
                    ".validate": "newData.isNumber()"
                  },
                  "$other": {
                    ".validate": false
                  }
                }
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "secret": {
          "$role": {
            ".read": "auth != null && root.child('pairs').child($code).child('members').child($role).val() === auth.uid",
            ".write": "auth != null && root.child('pairs').child($code).child('members').child($role).val() === auth.uid",
            "reserved": {
              "$wish": {
                ".validate": "newData.isBoolean()"
              }
            },
            "$other": {
              ".validate": false
            },
            "decided": {
              "$idea": {
                ".validate": "newData.val() === 'no' || newData.val() === 'maybe'"
              }
            }
          }
        },
        "votes": {
          "$role": {
            ".read": "auth != null && root.child('pairs').child($code).child('members').child($role).val() === auth.uid",
            "$idea": {
              ".write": "auth != null && root.child('pairs').child($code).child('members').child($role).val() === auth.uid && $idea.matches(/^i[0-9]{2}$/)",
              ".read": "auth != null && (($role === 'a' && root.child('pairs').child($code).child('members/b').val() === auth.uid && root.child('pairs').child($code).child('votes/b').child($idea).val() === true) || ($role === 'b' && root.child('pairs').child($code).child('members/a').val() === auth.uid && root.child('pairs').child($code).child('votes/a').child($idea).val() === true))",
              ".validate": "newData.val() === true"
            }
          }
        }
      }
    }
  }
}
