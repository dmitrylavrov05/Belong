              ".read": "auth != null && (root.child('pairs').child($code).child('members').child($role).val() === auth.uid || ($role === 'a' && root.child('pairs').child($code).child('members/b').val() === auth.uid && root.child('pairs').child($code).child('answers').child($day).child('b').exists()) || ($role === 'b' && root.child('pairs').child($code).child('members/a').val() === auth.uid && root.child('pairs').child($code).child('answers').child($day).child('a').exists()))",
              ".write": "auth != null && root.child('pairs').child($code).child('members').child($role).val() === auth.uid && $day.matches(/^[0-9]{5,6}$/)",
              ".validate": "newData.hasChildren(['text', 'at'])",
              "text": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "quiz": {
          "$round": {
            "$role": {
              ".read": "auth != null && (root.child('pairs').child($code).child('members').child($role).val() === auth.uid || ($role === 'a' && root.child('pairs').child($code).child('members/b').val() === auth.uid && root.child('pairs').child($code).child('quiz').child($round).child('b').child('done').val() === true) || ($role === 'b' && root.child('pairs').child($code).child('members/a').val() === auth.uid && root.child('pairs').child($code).child('quiz').child($round).child('a').child('done').val() === true))",
              ".write": "auth != null && root.child('pairs').child($code).child('members').child($role).val() === auth.uid && $round.matches(/^[0-9]{3,6}$/)",
              "self": {
                "$q": {
                  ".validate": "$q.matches(/^q[0-9]$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 3 && newData.val() % 1 === 0"
                }
              },
              "guess": {
                "$q": {
                  ".validate": "$q.matches(/^q[0-9]$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 3 && newData.val() % 1 === 0"
                }
              },
              "done": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "photo_data": {
          "$p": {
            ".read": "auth != null && (root.child('pairs').child($code).child('members/a').val() === auth.uid || root.child('pairs').child($code).child('members/b').val() === auth.uid)",
            ".write": "auth != null && (data.exists() ? !newData.exists() && root.child('pairs').child($code).child('members').child(data.exists() ? data.child('by').val() : newData.child('by').val()).val() === auth.uid : root.child('pairs').child($code).child('members').child(data.exists() ? data.child('by').val() : newData.child('by').val()).val() === auth.uid)",
            ".validate": "newData.hasChildren(['by', 'thumb', 'full'])",
            "by": {
              ".validate": "newData.val() === 'a' || newData.val() === 'b'"
            },
            "thumb": {
              ".validate": "newData.isString() && newData.val().length <= 80000 && newData.val().beginsWith('/9j/')"
            },
            "full": {
              ".validate": "newData.isString() && newData.val().length <= 1000000 && newData.val().beginsWith('/9j/')"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "feelings": {
          "$t": {
            "$role": {
              ".read": "auth != null && (root.child('pairs').child($code).child('members').child($role).val() === auth.uid || ($role === 'a' && root.child('pairs').child($code).child('members/b').val() === auth.uid && root.child('pairs').child($code).child('feelings').child($t).child('b').exists()) || ($role === 'b' && root.child('pairs').child($code).child('members/a').val() === auth.uid && root.child('pairs').child($code).child('feelings').child($t).child('a').exists()))",
              ".write": "auth != null && root.child('pairs').child($code).child('members').child($role).val() === auth.uid",
              ".validate": "newData.hasChildren(['feel', 'at'])",
              "what": {
                ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 1000"
              },
              "feel": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000"
              },
              "need": {
                ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 1000"
              },
              "ask": {
                ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 1000"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "voice_data": {
          "$v": {
            ".read": "auth != null && (root.child('pairs').child($code).child('members/a').val() === auth.uid || root.child('pairs').child($code).child('members/b').val() === auth.uid)",
            ".write": "auth != null && (data.exists() ? !newData.exists() : true) && root.child('pairs').child($code).child('members').child(data.exists() ? data.child('by').val() : newData.child('by').val()).val() === auth.uid",
            ".validate": "newData.hasChildren(['by', 'data', 'dur'])",
            "by": {
              ".validate": "newData.val() === 'a' || newData.val() === 'b'"
            },
            "data": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 700000"
            },
            "dur": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "letters": {
          "$l": {
            ".read": "auth != null && (root.child('pairs').child($code).child('members').child(data.child('by').val()).val() === auth.uid || ((root.child('pairs').child($code).child('members/a').val() === auth.uid || root.child('pairs').child($code).child('members/b').val() === auth.uid) && root.child('pairs').child($code).child('live/letters').child($l).exists() && (root.child('pairs').child($code).child('live/letters').child($l).child('kind').val() === 'when' || root.child('pairs').child($code).child('live/letters').child($l).child('openAt').val() <= now)))",
            ".write": "auth != null && (data.exists() ? !newData.exists() : true) && root.child('pairs').child($code).child('members').child(data.exists() ? data.child('by').val() : newData.child('by').val()).val() === auth.uid",
            ".validate": "newData.hasChildren(['by', 'text', 'at'])",
            "by": {
              ".validate": "newData.val() === 'a' || newData.val() === 'b'"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 5000"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
