<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_doodle_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="20dp"
        android:contentDescription="@string/widget_doodle_desc"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/widget_doodle_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/widget_doodle_empty"
        android:textColor="@color/ink2"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_doodle_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/ink2"
        android:textSize="12sp" />
</FrameLayout>
