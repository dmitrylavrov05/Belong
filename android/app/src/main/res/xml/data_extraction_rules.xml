<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the sign-in session is never backed up or moved to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="belong_account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="belong_account.xml" />
    </device-transfer>
</data-extraction-rules>
